;
; bbs.conf - a BBS for telnet, TN3270 and modem callers
;
; bbs -config /etc/bbs/bbs.conf check    checks this file
;
; Comments (; or #) go on lines of their own.  Values may be "quoted" to
; keep spaces at their ends; in quoted values \r \n \t \e and \xHH are those
; bytes.

[general]
; the system's name, its sysop's, and where it is (system info, @-codes)
name = D-Modem BBS
sysop = Sysop
;location = Somewhere, Earth
; how to reach it, for the system info (and @POSTAL@, @PHONE@, @ADDRESSES@):
; its postal address, the numbers callers dial, and its internet addresses
;postal_address = "1 Main St, Springfield"
;phone = "+1 555 0100 (300-33600), +1 555 0101 (V.92)"
;addresses = "telnet bbs.example.org, ssh bbs.example.org:2222, https://bbs.example.org/"
;; started as root, serve binds its ports (23, 79 ...) and sockets, then
; runs as this user (and its group, or group; with the user's other groups,
; for socket_group and docker): what it makes is that user's.  Other bbs
; commands run as root become it too (but check, config, backup restore).
; Under systemd: no User= then.  See docs/wiki/Running.md
;user = bbs
;group = bbs
; the database: SQLite's file, or a PostgreSQL, MySQL or MariaDB server (whose
; password then lives here: keep this file 0640).  bbs db copy moves one
; into another.  See docs/wiki/Databases.md
database = /var/lib/bbs/bbs.db
;database = postgres://bbs:PASSWORD@db.example.org/bbs
;database = mysql://bbs:PASSWORD@db.example.org:3306/bbs
;database = mariadb://bbs:PASSWORD@db.example.org:3306/bbs
; syslog (daemon facility), stderr, none, or a file
log = syslog
; shown before the login (text, or a file)
;banner = "Call us at 555-1000, 300 to 33600 bit/s."
;banner_file = /etc/bbs/banner.txt
; the message of the day, after the login: motd, then the file (read at
; each login)
;motd = "The line is down for maintenance on Sunday."
;motd_file = /etc/bbs/motd.txt
; the sysop's screens (display files): logon, newuser, welcome, goodbye and
; those menus name; NAME.ans (ANSI, CP437), NAME.asc (text), NAME.3270.
; screens.sample has some to start from
;screens_dir = /etc/bbs/screens
; the sysop's JavaScript: NAME.js runs from a menu's script:NAME, logon.js
; after each login; scripts.sample has some to start from
;scripts_dir = /etc/bbs/scripts
; a caller pages the sysop and no sysop is on: tell them this way ({user},
; {node} and {reason} filled in; no shell).  E.g. a push by ntfy.sh:
;page_command = curl -s -d "{user} on node {node}: {reason}" https://ntfy.sh/my-bbs-pages
; shown when a caller logs off
goodbye = Thanks for calling.
; QWK offline mail: the packets' name (BBSID.QWK), up to 8 letters and
; digits; by default made of the name.  See docs/wiki/Offline-Mail.md
;qwk_id = DMODEM
; the logo: a PNG (at most 1000x400), shown as sixel graphics on telnet
; terminals that have them, and on 3270s (below).  Without one, the
; system's name is drawn in a pixel font
;logo = /etc/bbs/logo.png
; 3270 graphics.  Box drawing (graphic escape) is used wherever the
; terminal has it.  tn3270_symbols: the logo (the system's name, or
; tn3270_logo, a PNG, or logo: one color, dark or opaque pixels drawn) loaded as programmed
; symbols on terminals that take them (IBM PCOMM, HostExplorer; not the
; x3270 family).  tn3270_vector: pictures (an image board's) drawn in the
; terminal's own colors, and the logo, with vector graphics on terminals
; that have them (PCOMM with host graphics on); without them, pictures
; are drawn in programmed symbols (tn3270_symbols), in blocks (graphic
; escape, x3270), or said in words
tn3270_symbols = yes
tn3270_vector = yes
;tn3270_logo = /etc/bbs/logo.png
; file areas: where the files are kept (by number, never by their names),
; the largest file, and what a user may upload a day (sysops: no limit)
files_dir = /var/lib/bbs/files
max_file_size = 64M
upload_quota = 256M
; callers may make their own accounts (NEW at the login, PF5 on a 3270)
new_users = yes
; callers at once, on all listeners together
max_nodes = 32
; logins before hanging up, seconds after a wrong one
attempts = 3
fail_delay = 3
; seconds to log in, and for a key once logged in
login_timeout = 120
idle_timeout = 600
; this many failed logins (or new accounts) from one IP address or caller
; ID within throttle_time seconds turn it away until they age out
; (0: never).  Callers with neither (a modem server's, no caller ID) are
; not throttled: one would lock out all
throttle_failures = 10
throttle_time = 600
; where callers are.  geoip: a country database, a MaxMind DB (.mmdb:
; GeoLite2 Country, DB-IP Lite...) or a CSV of ranges, read again when it
; changes; with it the log, who's online and the web forum's flags give
; callers' countries.  A city database (GeoLite2 City, DB-IP City Lite,
; IP2Location DB3 and up) gives the log and the sysop their region and
; city too (some 120 MB of memory).  geoip_credit: the credit its licence
; asks for, at the foot of the pages that show it.  See
; docs/wiki/Modem-Callers.md
;geoip = /var/lib/bbs/dbip-country-lite.mmdb
;geoip = /var/lib/bbs/dbip-city-lite.mmdb
;geoip_credit = IP geolocation by DB-IP
;geoip_credit_url = https://db-ip.com
; phone_country: the country (ISO 3166: US, GB, DE) whose national numbers
; modem caller IDs are, as the exchange sends them ("4155550123",
; "02071234567"); international ones (+44..., 011 44...) are read anyway.
; A caller ID gives the country, the kind of number and, where the plan
; says, the place (by libphonenumber's tables, built in)
;phone_country = US

; A listener:
;   type = telnet        a telnet server; with tn3270 = yes (the default),
;                        a client that says it is a 3270 (IBM-3278-2-E,
;                        IBM-DYNAMIC) gets the 3270 screens
;          raw           the caller's bytes as they come, no protocol:
;                        app_dmodem's mode = tcp, modemmenu tcp/unix items
;          rlogin        RFC 1282, as modemmenu's rlogin items speak it
;          ssh           SSH: passwords or users' keys (host_keys, legacy)
;   address = host:port  or a unix socket's path (/run/bbs/bbs.sock)
;   via = ...            how its callers came, in who's online
;                        (telnet, modem, rlogin by type)
;   ansi = auto          the terminal's ANSI color: auto asks the terminal
;                        (or believes its terminal type), yes, no
;   utf8 = auto          UTF-8 both ways: auto by the terminal type (xterm
;                        and friends yes; "ansi" BBS terminals no), yes, no
;   sixel = auto         the logo as sixel graphics on terminals that say
;                        they have them (device attributes); no.  auto for
;                        telnet, no for raw and rlogin (slow modem lines)
;   petscii = no         Commodore 64s and 128s: yes (every caller is one),
;                        auto (a caller that is not ANSI is watched while it
;                        logs in: a key only a C64 has, or DEL asked for
;                        after a name in capitals, makes it PETSCII), no
;   vt = auto            ask terminals what they are (answerback, DA1, DA2,
;                        XTVERSION; ESC Z for a VT52): DEC line drawing for
;                        VTs without UTF-8, bold on monochrome VTs, a VT52's
;                        escapes; no: ask nothing
;   rip = auto           RIPscrip menus and screens for terminals that answer
;                        ESC [ ! (BBS terminals; modern ones are not asked),
;                        yes, no
;   max_per_ip = 4       connections at once from one address (loopback
;                        and unix sockets: no limit, they are modem servers)
;   header = no          yes: a session header comes first, NAME=value lines
;                        and an empty line: app_dmodem's DMODEM_* or a
;                        modemmenu item's MODEM_* (rate, caller ID, number)
;   header_timeout = 10  seconds for the header
;   handoff = no         type = raw on a unix socket, with header = yes:
;                        the caller's line itself may come with the header
;                        (SCM_RIGHTS, modemmenu's item with handoff = yes),
;                        the session then on that terminal, nothing copied;
;                        closing the connection gives the line back
;   trust_user = no      yes: the header's MODEM_USER (an rlogin's server
;                        user) is logged in without a password.  Only where
;                        nothing but trusted menus can connect
;   create_users = no    yes, with trust_user: a user unknown here gets an
;                        account (with no password of its own)
;   socket_mode = 0660   a unix socket's permissions
;   socket_group = ...   and its group
;   frontend = bbs       what callers get: the BBS, or compuserve: the
;                        CompuServe Information Service (telnet and raw
;                        listeners; no 3270).  See the wiki's CompuServe.
;                        Or marvel: The Microsoft Network, for the MSN
;                        client of Windows 95 dialing in (telnet and raw).
;                        See the wiki's MSN-Classic
;   connect = 9600       compuserve: the CONNECT line before Host Name:
;                        (telnet: 9600; raw: none, the modem says its own)

; keeping callers out: a file of addresses and networks refused, one of
; names no new user may take (* wildcards), the hack log, and how long an
; address throttled for failed logins is banned outright
;[security]
;deny_file = /etc/bbs/deny.txt
;name_deny_file = /etc/bbs/names.txt
;hack_log = /var/log/bbs/hack.log
;ban_minutes = 60

; scheduled events: a program (no shell), daily at a time or every N
; minutes; see the wiki's Sysop tools
;[event poll]
;command = /usr/local/bin/poll-something
;every = 60
;timeout = 600

; Backups: this file, the database (a SQLite file, whatever the engine,
; taken whole at one moment while callers are on) and the files' directories
; (file areas, image boards, FidoNet, screens, scripts), one archive
; (bbs-YYYYMMDD-HHMMSS.tar.gz) a backup.  bbs backup makes one now; bbs
; backup restore ARCHIVE puts one back.  See docs/wiki/Backups.md
;[backup]
; where the archives go (by default backups beside an SQLite database; a
; server's database needs one said).  Keep it on another disk if you can
;dir = /var/backups/bbs
; daily, at this time (none: only when asked)
;at = 03:30
; archives kept, the oldest taken away (0: all)
;keep = 7
; the files' directories too (no: the configuration, database and SSH host
; keys alone)
;files = yes

; Certificates from Let's Encrypt, ZeroSSL or any ACME CA, got and renewed
; by the BBS itself (in the manner of acme.sh), for every TLS server here:
; one given no cert_file (or tls_cert) and key_file uses them, the one whose
; names cover the name the client asks for, or the first.  cert_file = acme
; says so outright; cert_file = acme:NAME picks an [acme NAME].  Gemini
; (its pinned certificate) and Yahoo! Messenger (login.yahoo.com's) keep
; their own unless told.  They are kept in acme/
; beside the database, renewed 30 days before they run out (or when the CA
; says), and read again by every server as they change.  bbs acme list
; shows them; bbs acme renew gets them now.  See docs/wiki/Certificates.md
;[acme]
; the account's contact: the CA writes here of a certificate not renewed
;email = sysop@example.org
; letsencrypt, letsencrypt-staging (for trying it out), zerossl, buypass,
; google, sslcom, or a directory's URL
;ca = letsencrypt
; External Account Binding, for CAs that need it (Google's; ZeroSSL's is got
; by email if not given)
;eab_kid = kid-from-the-ca
;eab_hmac_key = base64url-key
; the names of [acme]'s own certificate (named default); more in [acme NAME]
;domains = bbs.example.org, www.bbs.example.org
; how the CA is shown the names are this host's: http (a token on port 80),
; tls-alpn (a certificate on port 443, from any TLS server of the BBS's
; there) or dns (a TXT record; the only one for *.wildcards)
;challenge = http
; HTTP-01's port 80 (by default :80 when a certificate uses it, unless a web
; server here is on port 80 already, which answers it then; no: none)
;http_address = :80
; DNS-01's provider: cloudflare, route53, digitalocean, hetzner, gandiv5,
; ovh, namecheap, porkbun, godaddy, desec, duckdns, pdns, rfc2136, acme-dns,
; httpreq; exec:PROGRAM (run as PROGRAM present|cleanup NAME VALUE); or
; acmesh:dns_xx, one of acme.sh's 150 dnsapi scripts (needs acmesh)
;dns = cloudflare
; KEY=value lines: the provider's credentials, as lego names them for its
; providers (CF_DNS_API_TOKEN=...) or acme.sh for its (CF_Token=...)
;dns_env_file = /etc/bbs/acme-dns.env
; acme.sh, for dns = acmesh:..., and its home if not beside it (where its
; account.conf keeps the credentials it saved)
;acmesh = /home/bbs/.acme.sh/acme.sh
;acmesh_home = /home/bbs/.acme.sh
; DNS servers asked whether the record is out yet (default: the system's)
;dns_resolvers = 1.1.1.1:53, 8.8.8.8:53
; how: authoritative (the zone's own servers), resolvers (dns_resolvers) or
; no (just wait dns_wait seconds, as acme.sh's --dnssleep)
;dns_check = authoritative
;dns_wait = 0
; the key: ec256, ec384, rsa2048, rsa3072 or rsa4096 (Windows XP's clients
; know only RSA)
;key_type = ec256
; renew this many days before the end
;renew_days = 30
; run (by sh) after each new certificate, with CERT_NAME, CERT_FILE,
; KEY_FILE and CERT_DOMAINS set: to hand it to other programs
;hook = systemctl reload nginx
; where the account and certificates are kept (default acme/ beside the
; database)
;dir = /var/lib/bbs/acme

; a certificate of its own, for a TLS server to name (cert_file =
; acme:mail); challenge, dns and key_type as in [acme], whose they are by
; default
;[acme mail]
;domains = mail.example.org, imap.example.org, smtp.example.org
;challenge = tls-alpn
;key_type = ec256

; telnet and TN3270, for everyone (port 23 needs root or
; CAP_NET_BIND_SERVICE)
[listen telnet]
type = telnet
address = :2300
tn3270 = yes
max_per_ip = 4

; telnet over TLS (port 992), for SyncTERM (TelnetS), c3270 L:host:992;
; tls_cert = acme for the [acme] certificate
;[listen telnets]
;type = telnet
;address = :992
;tls_cert = /etc/bbs/cert.pem
;tls_key = /etc/bbs/key.pem

; app_dmodem's [bbs] profile (mode = tcp, host = 127.0.0.1, port = 2323):
; modem callers, raw.  Keep it to 127.0.0.1
[listen modem]
type = raw
address = 127.0.0.1:2323

; the CompuServe Information Service, on the BBS's users: Host Name: CIS,
; then a User ID (shown at logon) or BBS name and the BBS password
;[listen cis]
;type = telnet
;address = :2324
;frontend = compuserve

; SSH: the text BBS, encrypted.  Users log in with their BBS password or
; a key (bbs sshkey add, or their profile); "new" gets the BBS's prompt
; to sign up.  Host keys are made beside the database the first time
;[listen ssh]
;type = ssh
;address = :2222
;max_per_ip = 4
;host_keys = /etc/bbs/ssh_host_ed25519_key /etc/bbs/ssh_host_rsa_key
; old clients only: CBC ciphers and 1024-bit DH too
;legacy = no

; modemmenu's rlogin item: the caller's modemmenu login and password are
; checked here (the same accounts on both, or the caller logs in again)
[listen rlogin]
type = rlogin
address = 127.0.0.1:2513

; modemmenu's unix item with header = yes: modemmenu has logged the caller
; in, and the BBS believes it.  Only modemmenu may connect: the socket's
; group is Asterisk's (which modemmenu runs as)
;[listen menu]
;type = raw
;address = /run/bbs/menu.sock
;header = yes
;trust_user = yes
;create_users = yes
;socket_mode = 0660
;socket_group = asterisk

; the same with the caller's line itself (modemmenu's item with
; handoff = yes): the BBS on the modem's terminal, nothing copied between
;[listen handoff]
;type = raw
;address = /run/bbs/handoff.sock
;header = yes
;handoff = yes
;trust_user = yes
;create_users = yes
;socket_mode = 0660
;socket_group = asterisk

; modemmenu's auth socket ([authd] there): the accounts modemmenu logs in
; (no password here) log in by telnet, SSH, the web ... with their
; modemmenu password, asked of modemmenu's backends.  See
; docs/wiki/Modem-Callers.md
;[modemmenu]
;auth_socket = /run/modemmenu/auth.sock
; a user modemmenu knows and the BBS does not gets an account at their
; first login, any way in
;create_users = yes
; seconds for its answer
;timeout = 15

; The HTTP API (REST, server-sent events, and WebSockets in JSON and
; protobuf): see docs/wiki/HTTP-API.md.  Tokens: POST /api/v1/login, or
; bbs token add USER -scope read,post.  Without this section there is none
;[http]
;address = :8443
; TLS is the default; tls = no only on 127.0.0.1 behind a proxy that has it.
; With no cert_file and key_file, the [acme] certificates
;cert_file = /etc/bbs/tls/cert.pem
;key_file = /etc/bbs/tls/key.pem
; behind a reverse proxy (nginx, Caddy): its addresses (or ranges), which
; are believed when they say whose a request is (X-Forwarded-For,
; Forwarded, X-Real-IP), for rate limits, logs, bans and the deny lists.
; secure_cookies: logins' cookies over HTTPS only (the default with tls =
; yes; say yes when the proxy has TLS)
;trusted_proxies = 127.0.0.1, ::1
;secure_cookies = yes
; anonymous callers may see /system and /who
;anonymous = yes
; one browser origin allowed to call it (no *)
;cors = https://www.example.org
; Prometheus metrics, on an address of their own (keep it private)
;metrics = 127.0.0.1:9100
; connections at once from one address
;max_per_ip = 20
; requests a second per token (or per IP without one), and the burst
;rate = 10
;burst = 20
; how long a /login session lasts
;session_hours = 24
; the web terminal at /terminal: the BBS in a browser (xterm.js, built in)
;terminal = yes
; the web forum at /forum/ (and /): the message areas as a bulletin board;
; forum_guests: those not logged in read the areas anyone may read
;forum = yes
;forum_guests = yes
; forum_flags: posters' countries' flags by their names, where [general]
; geoip or phone_country knew them when they posted
;forum_flags = yes
; the forum's theme until a caller chooses (at the foot of each page):
; ipb3 (in the manner of Invision Power Board 3), ipb5 (fresh, as Invision
; Community 5), ipb4 (modern, as Invision Community 4), ipb2 (classic, as
; IPB 2), ipb1 (retro, as IPB 1), ikon (grey, as Ikonboard 2), vb6 (clean,
; as vBulletin 6), vb5 (connect, as vBulletin 5), vb4 (steel, as vBulletin
; 4), vb3 (blue, as vBulletin 3), vb2 (purple, as vBulletin 2), vblite
; (lavender, as vBulletin Lite), xf23 (light, as XenForo 2.3), xf2 (xen, as
; XenForo 2), xf1 (classic, as XenForo 1), mybb18 (flat, as MyBB 1.8),
; mybb16 (classic, as MyBB 1.6), mybb12 (original, as MyBB 1.2), pun14
; (oxygen 2, as PunBB 1.4), flux15 (air, as FluxBB 1.5), pun12 (oxygen, as
; PunBB 1.2), yabb25 (silver, as YaBB 2.5), yabb2 (default, as YaBB 2),
; yabb1 (gold, as YaBB 1 Gold), smf30 (natural, as Simple Machines Forum
; 3.0), smf21 (simple, as SMF 2.1), smf20 (curve, as SMF 2.0), smf1 (core,
; as SMF 1), phpbb33, phpbb32, phpbb31 and phpbb30 (prosilver, as phpBB 3.3,
; 3.2, 3.1 and 3.0), phpbb2 (silver, as phpBB 2) or phpbb1 (dark, as phpBB
; 1)
;forum_theme = ipb3
; the image boards at /chan/ (bbs chan board add b Random); see
; docs/wiki/Image-Boards.md
;chan = yes

; How the image boards are run
;[chan]
; images and thumbnails, a directory a board; and the boards' secret
;dir = chan
; the largest image (a board can have its own: bbs chan board set)
;max_file = 4M
; flood control: seconds between an address's threads, and its posts
;thread_wait = 60
;reply_wait = 15
; the longest comment, in characters
;max_comment = 2000
; JPEGs' EXIF (where a phone took the photo) taken out
;strip_metadata = yes
; those not signed in answer a captcha (made here) to post; the BBS's
; users signed in at /chan/login, and callers on the terminals, do not
;captcha = yes
; its letters (4 to 10), how hard to read (easy, normal, hard), and the
; seconds one lasts
;captcha_length = 6
;captcha_level = normal
;captcha_lifetime = 600
; the post form's Options line (sage: no bump; nonoko); a board may say
; otherwise: bbs chan board set DIR options yes|no|default
;options = yes
; files besides images, on the boards that take them (bbs chan board set
; DIR files webm,mp4,pdf; sound yes): the programs that make their
; thumbnails (a video's first frame, a PDF's first page; without them a
; card saying what the file is), and the longest a video may run, in
; seconds (0: any)
;ffmpeg = ffmpeg
;pdftoppm = pdftoppm
;max_video = 120
; Flash (files swf,flv), played in the page by Ruffle: its self-hosted
; package's directory (make ruffle fetches it into ruffle/)
;ruffle = /opt/bbs/ruffle
; days a thread pruned off a board's last page stays in its archive
; (/chan/b/archive: read-only, its files kept; 0: always).  A board can
; keep none: bbs chan board set DIR archive no
;archive_days = 3
; a country database for the boards with flags (bbs chan board set DIR
; flags yes): a MaxMind DB (.mmdb: GeoLite2 Country, DB-IP Lite...) or a
; CSV of ranges; read again when it changes.  By default [general]'s
;geoip = /var/lib/bbs/GeoLite2-Country.mmdb
; the credit its licence asks for, at the foot of each page (by default
; [general]'s)
;geoip_credit = IP geolocation by DB-IP
;geoip_credit_url = https://db-ip.com
; the style callers get until they choose: by the board (yotsuba-b if it
; is worksafe, else yotsuba), or yotsuba, yotsuba-b, futaba, burichan,
; photon, tomorrow
;style =

; Access levels: a user's level (0-255) gets what the [level] at or
; below it says; areas, doors and menus may require a level and flags
; (bbs area require, require = in [door] and [menu]).  See
; docs/wiki/Access-Levels.md.  Without any, nothing is limited
;[general]: new_user_level = 20, validated_level = 20
;[level 10]
; shown in the profile and to the API
;name = New user
; minutes online a day, and files downloaded a day (0: no limit)
;time = 30
;downloads = 2
; files a user may download for each they upload (0: no ratio), and how
; many before the ratio counts
;ratio = 3
;ratio_free = 10
; what it may do (yes unless it says no): post, mail, chat, page the
; sysop, download, upload, doors
;post = no
;mail = no
;chat = no
;page = yes
;download = yes
;upload = no
;doors = yes
;[level 20]
;name = Member
;time = 120
;downloads = 20

; The FTP server for the file areas: users log in with their BBS name and
; password; each file area is a directory.  bbs filearea add NAME makes
; one.  Without this section there is no FTP server
;[ftp]
;address = :2121
; passive data connections: open these in the firewall too
;passive_ports = 50000-50100
; behind NAT: the public IP address passive replies give
;public_host = 203.0.113.7
; required: explicit FTPS (AUTH TLS before USER); implicit: TLS from the
; first byte; optional or no: passwords may cross in the clear
;tls = required
;cert_file = /etc/bbs/cert.pem
;key_file = /etc/bbs/key.pem
; anonymous and ftp may log in to download
;anonymous = no
; connections at once, and from one address; seconds idle before one is
; closed
;max_clients = 32
;max_per_ip = 4
;idle_timeout = 300
; the address users are told, in the file areas
;advertise = bbs.example.org:2121

; Newsgroups: a message area with a newsgroup name (bbs area newsgroup
; General bbs.general) is a newsgroup, served by NNTP to newsreaders and
; kept in step with peer news servers.  [news] names this site in Path and
; Message-IDs; it defaults to the machine's name
;[news]
;hostname = news.example.org
;domain = news.example.org
;organization = D-Modem BBS
; the largest article taken (from readers and peers)
;max_article = 64K

; The NNTP server.  Without this section there is none (peers still sync)
;[nntp]
;address = :1119
; no, optional (STARTTLS), required (no AUTHINFO before STARTTLS), implicit
; (TLS from the first byte, NNTPS: usually port 563)
;tls = required
;cert_file = /etc/bbs/cert.pem
;key_file = /etc/bbs/key.pem
; read = anyone, or users: AUTHINFO first.  post = yes: logged-in users post
;read = anyone
;post = yes
; connections at once, and from one address; seconds idle before one is
; closed
;max_clients = 32
;max_per_ip = 8
;idle_timeout = 600

; A peer news server, one section each.  pull: its new articles in our
; newsgroups are fetched (GROUP, OVER, ARTICLE); push: our new articles are
; offered (IHAVE, or POST if it refuses IHAVE).  accept_from: the addresses
; it may send us articles from by IHAVE (nothing else may)
;[peer upstream]
;address = news.example.net:119
;tls = starttls
;ca_file = /etc/bbs/peer-ca.pem
;username = bbs
;password = secret
;groups = bbs.*,!bbs.test
;pull = yes
;push = yes
;interval = 600
;max_per_run = 1000
; on first contact, how many of each group's latest articles to fetch
;initial = 100
; the addresses it may send us articles from (IHAVE)
;accept_from = news.example.net

; E-mail.  Each user is name@domain (bbs mail address NAME shows it), and
; their BBS mail is their e-mail: Inbox, Sent, Drafts, Starred, Unread,
; All Mail and Trash, in any mail program, over POP3 and IMAP.  Without
; this section the BBS has no e-mail
;[mail]
;domain = example.org
; this host's name, said in SMTP's greeting and Received lines
;hostname = mail.example.org
; how mail for elsewhere goes: direct (to each domain's MX, port 25),
; smarthost (through [smarthost]) or none (only mail here)
;outbound = direct
; the largest message taken; recipients in one; days in the trash before
; mail is gone (0: until emptied); days the queue keeps trying
;max_message = 10M
;max_recipients = 50
;trash_days = 30
;queue_days = 5
; who gets postmaster@, abuse@ and bounces' notes (default: the sysop)
;postmaster = sysop
; DKIM: bbs mail dkim /etc/bbs/dkim.pem makes the key and prints its DNS
; record (selector._domainkey.domain)
;dkim_key_file = /etc/bbs/dkim.pem
;dkim_selector = bbs
; the certificate for the mail servers (each can name its own)
;cert_file = /etc/bbs/cert.pem
;key_file = /etc/bbs/key.pem

; An outgoing mail server to send through, instead of straight to each
; domain's MX: your provider's, or a relay such as Postfix.  tls: starttls,
; implicit (port 465) or no.  insecure = yes: its certificate unchecked
;[smarthost]
;address = smtp.example.net:587
;tls = starttls
;username = bbs@example.org
;password = secret
;insecure = no

; The mail servers: each runs only with its section.  tls: no, optional
; (STARTTLS offered), required (STARTTLS before a login) or implicit (TLS
; from the first byte: POP3S 995, IMAPS 993, SMTPS 465).  Each takes
; address, tls, cert_file, key_file, max_clients, max_per_ip and
; idle_timeout, as [nntp] does.  POP3: mail programs fetch the inbox
;[pop3]
;address = :1110
;tls = required

; IMAP: mail programs read and file mail in the folders.  Its IDLE wants a
; long idle_timeout
;[imap]
;address = :1143
;tls = required
;idle_timeout = 1800

; mail submission: users send mail, logged in (port 587 or 465)
;[smtp]
;address = :1587
;tls = required

; mail from the internet: on port 25, named by the domain's MX record.
; checks = yes: SPF, DKIM and DMARC checked; mail is refused that fails
; a DMARC reject policy, or (no DMARC) fails SPF and is not signed
;[mx]
;address = :25
;tls = optional
;checks = yes
; DNS blocklists the sending address is looked up in (none by default).
; A listed sender is refused at MAIL FROM (554, with the list's reason);
; a list that does not answer refuses no one.  Spamhaus refuses queries
; through public resolvers (8.8.8.8, 1.1.1.1) and wants a paid feed for
; heavy or commercial use: run a resolver of your own (unbound) for it
;dnsbl = zen.spamhaus.org, bl.spamcop.net

; LMTP, for a mail server in front (Postfix's virtual_transport) to hand
; mail in: a unix socket's path or host:port
;[lmtp]
;address = /run/bbs/lmtp.sock

; FidoNet (or another FTN network).  bbs area echo General FSX_GEN makes an
; area an echo; mail to Name@zone:net/node is netmail.  Without this section
; the BBS is not on FidoNet
;[fido]
; our address, then any AKAs
;address = 21:1/999
; the origin line under echomail written here
;origin = D-Modem BBS, by phone and telnet
; inbound, outbound and bad packets go under it
;dir = /var/lib/bbs/fido
; what messages are written in: cp437 (what FidoNet reads) or utf-8
;charset = cp437
; the largest message taken
;max_message = 64K
; nodelists, to check netmail and look systems up: paths or patterns (the
; newest file of each), or area:NAME, the newest file in a file area
;nodelist = /var/lib/bbs/fido/nodelist/NODELIST.* area:Nodelist

; binkp: answer the links' calls.  Without it, links are only called
;[binkp]
;address = :24554
;max_clients = 16
;max_per_ip = 4

; A system we exchange mail with, one section each
;[link hub]
;address = 21:1/100
; to call it (port 24554 if none); without a host it calls us; nodelist:
; where the nodelist says
;host = hub.example.net:24554
; the session password (CRAM-MD5); and the packets', up to 8 characters
;password = secret
;packet_password =
; it may be sent in the clear to a mailer without CRAM-MD5
;plain_password = no
; the echoes exchanged with it: a wildmat of tags
;echoes = FSX_*
; netmail for systems that are not links goes by it (one link at most)
;route = yes
; the file echoes (TIC) exchanged with it: a wildmat (none if unset); and
; the TICs' password, both ways
;fileechoes = FSX_*
;tic_password =
; it asks for echoes and file echoes by AreaFix and FileFix (of those
; echoes and fileechoes allow) with this password; we ask its with it too
;areafix = no
;areafix_password =
; make the echoes and file echoes it sends that are not here
;create = no
; how mail to it is bundled: zip, arc, arj, lha; none: bare packets
;packer = zip
; call it every this many seconds, mail or not (0: only with mail)
;poll = 3600
; which of our addresses it knows us by (default: ours in its zone)
;aka = 21:1/999

; QWK networks this BBS is a node of (DOVE-Net and the like), one section
; each.  The BBS calls the hub by FTP, puts a REP of what was written here
; in the network's areas, and takes the hub's packet.  A hub run by this
; BBS gives each node an account: bbs user qwknode NAME.
; See docs/wiki/Offline-Mail.md
;[qwknet dovenet]
; the hub's FTP server
;address = hub.example.org:21
; FTPS: explicit (AUTH TLS), implicit, or no
;tls = explicit
; the account the hub gave this node
;user = MYBBS
;password = secret
; where the hub keeps its packet ("/" for one in the root)
;dir = /qwk
; the hub's BBSID (by default: the packet found there)
;hub_id = VERT
; call it every this many minutes (0: only with bbs qwknet call)
;every = 60
; CONFERENCE = AREA: the hub's conferences carried here, and their areas
;2001 = DOVE General
;2002 = DOVE Chat

; Doors: programs callers on the text BBS play (D on the main menu).  The
; BBS writes drop files (DOOR.SYS, DORINFO1.DEF, DOOR32.SYS, CHAIN.TXT) into
; the node's own directory and joins the caller's line to the door until it
; ends, the caller hangs up, or the time is up.  One section each
;
;
; A DOS door, in dosemu2 in Docker (make doors-image).  F: is /srv/doors,
; G: the node's drop files; the caller is on COM1 behind a FOSSIL.  The BBS
; must run as a user in the docker group, not root: --user {uid}:{gid}
; runs the door as that user, so that it can write the node's directory
;[door lord]
;description = Legend of the Red Dragon
;command = docker run --rm -i --network none --name bbs-door{node} --user {uid}:{gid} -v /srv/doors:/doors -v {dir}:/node bbs-dosemu2 'F:\LORD' 'START.BAT {node}'
; the node's directory ({node} its number): mounted as /node above
;dir = /var/lib/bbs/doors/node{node}
;drop_files = door.sys dorinfo1.def door32.sys chain.txt
; cp437: shown as UTF-8 to UTF-8 terminals; utf-8; raw: as it comes
;charset = cp437
; minutes a visit
;time_limit = 60
; yes: for sysops only
;sysop_only = no
; yes: one caller at a time (a door that is not multi-node)
;single = no
; after the door: make sure its container is gone
;cleanup = docker rm -f bbs-door{node}
;
; A program for Linux: on a pseudo-terminal, in UTF-8
;[door adventure]
;command = /usr/games/adventure
;charset = utf-8
;pty = yes
;door32_comm = local
;
; Doors elsewhere: the caller joined to another system's doors (no
; command, no drop files).  See docs/wiki/Doors.md
; a telnet door server
;[door far]
;type = telnet
;address = doors.example.org:2323
; an RLogin door server ({user}: the caller's name)
;[door rlogin]
;type = rlogin
;address = doors.example.org:513
; the names it is given: the caller's ({user})
;client_user = {user}
;server_user = {user}
; BBSLink (bbslink.net): the codes it gave you, and a door's code
;[door bbslink-lord]
;type = bbslink
;syscode = XXXXXX
;authcode = XXXXXX
;schemecode = XXXXXX
;door = lord
; its web address, for the codes (by default http://games.bbslink.net)
;url = http://games.bbslink.net
; DoorParty: its SSH account, your system tag, a door's code ("": its menu)
;[door doorparty]
;type = doorparty
;ssh_user = myuser
;ssh_password = secret
;tag = XB
;door = lord
;host_key = SHA256:...
; its RLogin server, where the SSH session goes on to
;rlogin_address = dp.throwbackbbs.com:513

; IRC: the chat rooms as channels (#main ...), for IRC clients.  Users log
; in with their BBS names and passwords (SASL PLAIN, or the server
; password as name:password).  See docs/wiki/IRC.md
;[irc]
;address = :6667
; IRC over TLS (and address = none for TLS only); with no tls_cert and
; tls_key, the [acme] certificates
;tls_address = :6697
;tls_cert = /etc/bbs/tls.crt
;tls_key = /etc/bbs/tls.key
;server_name = irc.example.org
;network = DModem
;max_clients = 64
;max_per_ip = 4
; the services bot's nick: /msg BBSServ HELP (your account's settings)
;service = BBSServ

; AIM and ICQ: the chat for AIM and ICQ clients (OSCAR), beside IRC.  Users
; sign on with their BBS names (or ICQ numbers: uin_base plus the account's
; number) and passwords; buddies are the BBS's users, online by any route;
; an IM is a private message (a PRIVMSG on IRC), a chat room a room (an IRC
; channel).  The port is AOL's 5190, which AOL's own clients will share.
; See docs/wiki/AIM-and-ICQ.md
;[oscar]
;address = :5190
; where clients are sent to reconnect, host:port (default: the address
; each one came to; set it behind NAT)
;host = aim.example.org:5190
;max_clients = 256
; each client opens a few connections: sign-on, the BOS, chat rooms
;max_per_ip = 16
; an account's ICQ number is this plus its number
;uin_base = 100000
; the screen name the BBS's notices come from
;system = OnlineHost

; IRC server linking: the BBS as a hub server on an IRC network, by TS6
; (Solanum, charybdis, ircd-ratbox; ircd-hybrid 8 with protocol = hybrid)
; or P10 (ircu, Undernet's, with protocol = p10).
; Every BBS user online is a user there, whom anyone can /msg and /whois;
; the rooms beginning irc- are its channels (irc-retro is #retro).  A nick
; taken there is the BBS user's as Nick|Tag.  See docs/wiki/IRC-Linking.md
;[irclink]
; the BBS's server name on the network
;server_name = irc.bbs.example.org
; the TS6 server ID: a digit, then two letters or digits, the network's own
;sid = 1BB
; the P10 server numeric, 0 to 4095, the network's own (for a P10 link)
;numeric = 42
; its description, in LINKS (default: the BBS's name)
;description = The D-Modem BBS
; the network's name, as WHOIS of its users shows it
;network = MyNet
; Nick|Tag for a BBS user whose nick is taken
;tag = DM
; the BBS users' host, as the network sees them (default: server_name)
;host = users.bbs.example.org
; the rooms that are channels (none: every room)
;prefix = irc-
; the network's NICKLEN (Solanum's 31 less one; ratbox and hybrid: 9;
; ircu: 12, the default with a P10 peer)
;nick_length = 30
; where servers link in (and address = none for none)
;address = :7000
;tls_address = :7001
; the certificate and key for tls_address
;tls_cert = /etc/bbs/tls.crt
;tls_key = /etc/bbs/tls.key
; between tries of a link out, in seconds
;retry = 30

; A server the BBS links with, one section each: [ircpeer ITS.NAME]
;[ircpeer hub.example.net]
; where to link out to (none: it links in)
;address = hub.example.net:7000
; link out by TLS
;tls = yes
; check its certificate (a self-signed one: no)
;tls_verify = yes
; the password we send it (its accept_password)
;send_password = ours-to-it
; the password it sends us (its send_password)
;accept_password = its-to-us
; its users' tag, beside a BBS user of the same nick (Nick|Tag)
;tag = HUB
; ts6 (Solanum, charybdis, ratbox), hybrid (ircd-hybrid 8) or p10 (ircu)
;protocol = ts6

; AOL: a host for AOL's own clients (3.0, 4.0 and on, over TCP).  Users sign
; on with their BBS names and passwords and get the BBS's Welcome window.
; The client's port is 5190: with [oscar] there too, the two share it.  The
; client finds its host as AmericaOnline.aol.com (point that name here in
; its machine's hosts file, or edit its TCP.CCL).
;[aol]
;address = :5190
;max_clients = 256
;max_per_ip = 4

; MSN Messenger: the chat for MSN Messenger 1.0 to 4.7 and Windows
; Messenger 4.x (MSNP2 to 7), beside IRC and AIM.  Users sign in as
; name@domain with their BBS passwords; contacts are their friends list;
; an IM is a private message (a PRIVMSG on IRC), kept for one away.  The
; clients must be pointed at this host (see the wiki page).
; See docs/wiki/MSN-Messenger.md
;[msn]
;address = :1863
; where clients are sent for conversations, host:port (default: the
; address each one came to; set it behind NAT)
;host = msn.example.org:1863
; handles are name@domain (default bbs.invalid); clients may sign in with
; any domain, as MSN 1.0's @hotmail.com
;domain = msn.example.org
;max_clients = 256
; each conversation is a connection of its own
;max_per_ip = 16
; the name the BBS's notices come from
;system = BBS
; a web address the clients' links (inbox, profiles) open
;site = https://bbs.example.org/

; The Microsoft Network of 1995 to 1998, for the MSN client that came with
; Windows 95: users sign in with their BBS names and passwords, the
; message areas are its Categories, and each area is an MSN bulletin
; board to read and post in.  Over TCP its port is 569, which the client
; can't be told otherwise; modem callers come through a listener with
; frontend = marvel.  See docs/wiki/MSN-Classic.md
;[marvel]
;address = :569
;max_clients = 64
;max_per_ip = 4

; Yahoo! Messenger: the chat for Yahoo! Messenger clients (YMSG 9 to 16),
; beside IRC, AIM and MSN.  Users sign in with their BBS names (without
; spaces) and passwords; the buddy list is their friends list and the
; ignore list their blocked list; an IM is a private message, kept for one
; away; Yahoo chat rooms are the chat rooms, and a conference a room of
; its own.  The clients must be pointed at this host (see the wiki page).
; See docs/wiki/Yahoo-Messenger.md
;[ymsg]
;address = :5050
; the web half, for Y!M 9 and later and the room list: point
; vcs1.msg.yahoo.com, vcs2.msg.yahoo.com and insider.msg.yahoo.com here
;http_address = :80
; Y!M 9's login, its password over HTTPS: point login.yahoo.com here, with
; a certificate for it the client trusts
;https_address = :443
;tls_cert = /etc/bbs/login.yahoo.com.crt
;tls_key = /etc/bbs/login.yahoo.com.key
; the pager's address the web half gives Y!M 9 (default: the address each
; one asked on; set it behind NAT)
;host = 203.0.113.5
;max_clients = 256
;max_per_ip = 4
; the Yahoo ID the BBS's notices come from
;system = bbs

; Multi Relay Chat: the BBSes' chat network.  Its rooms are the chat rooms
; beginning mrc- here (mrc-lobby is its lobby), on terminals and IRC alike.
; See docs/wiki/MRC.md
;[mrc]
;address = mrc.bottomlessabyss.net:5000
; or TLS, on 5001
;address = mrc.bottomlessabyss.net:5001
;tls = yes
;prefix = mrc-
;system_name = |11My |03BBS
;web = https://bbs.example.org/
;telnet = bbs.example.org:23
;ssh = bbs.example.org:22
;require = 20

; finger: who is on ("finger @host"), and who a user is ("finger name@host").
; Port 79 needs CAP_NET_BIND_SERVICE (bbs.service.sample)
;[finger]
;address = :79
;online = yes
;users = yes

; gopher: about the system, who is on, and what areas the sysop opens: no
; login, so anyone sees them.  Port 70 needs CAP_NET_BIND_SERVICE
;[gopher]
;address = :70
; the name and port menus send clients back to
;hostname = bbs.example.org
;port = 70
; message areas shown (a wildmat of area names; "": none)
;areas = general,announcements
; file areas listed and downloadable
;files = no

; gemini: gopher's capsule over Gemini (gemini://, TLS): about the system,
; who is on, users as finger tells of them, and what areas the sysop opens:
; no login, so anyone sees them.  Port 1965 needs no privilege
;[gemini]
;address = :1965
; the host name bbs gemini cert offers for a new certificate
;hostname = bbs.example.org
; the certificate and key (PEM); with neither, gemini-cert.pem and
; gemini-key.pem beside the database, which bbs gemini cert makes (it asks
; for the host names, organization and years first).  Clients trust it on
; first use and warn if it ever changes, so an ACME one (cert_file = acme)
; is for capsules whose visitors check it against a CA
;cert_file = /etc/bbs/gemini-cert.pem
;key_file = /etc/bbs/gemini-key.pem
; message areas shown (a wildmat of area names; "": none)
;areas = general,announcements
; file areas listed and downloadable
;files = no
; /users: look up a user, as finger tells of them
;users = yes

; News, weather and quotes: the main menu's [N], as the online services
; had them.  News feeds (RSS, Atom, JSON Feed) are posted to read-only
; message areas, made when first needed, so they are read everywhere areas
; are: the terminals, newsreaders (an area made a newsgroup), QWK, the web
; forum, gopher.  An item is its headline, its summary and a link: what
; feeds are published for.  bbs feeds catalog lists the feeds the BBS knows
;[feeds]
; a way to reach the sysop, sent to the sites read (the SEC refuses readers
; without one, the National Weather Service asks for one)
;contact = sysop@example.org
; feeds of the catalogue: all, groups (news, business, technology,
; science, government) or feeds by name
;catalog = all
; minutes between readings, and days items are kept (0: for ever), for
; feeds that say none of their own
;every = 30
;keep_days = 30
; the most items of a feed posted at one reading
;max_items = 50

; A feed of the sysop's, or changes to the catalogue's of that name
; (enabled = no leaves it out)
;[feed lobsters]
;enabled = yes
;url = https://lobste.rs/rss
;title = Lobsters
; the area (its name by default), and the group it is listed under
;area = Lobsters
;group = Technology
;description = Lobsters: computing
;every = 60
;keep_days = 14

; Each caller's weather, for where they say they are (a US ZIP code, a town
; anywhere, or a latitude and longitude): the National Weather Service's
; forecast and warnings in the US, Open-Meteo's forecast elsewhere
; (free for non-commercial use, credited), and the USGS's earthquakes near
;[weather]
; as [feeds] contact (which it defaults to)
;contact = sysop@example.org
; forecasts outside the US, from Open-Meteo
;international = yes
; earthquakes within this many km, of this magnitude or more
;quake_radius = 300
;quake_min = 2.5
; serious warnings (Severe, Extreme) where a caller is, told at the login
;alerts_at_login = yes

; Stock quotes from IEX (the Investors Exchange): its own trades and
; quotes, not the whole market's.  bbs quotes fetch reads IEX's free HIST
; file of the last session (some 16 GB, read as it comes: nothing is kept
; but the quotes) into file; an [event] runs it each morning:
;   [event quotes]
;   command = /usr/local/bin/bbs -config /etc/bbs/bbs.conf quotes fetch
;   at = 06:30
;   timeout = 3600
; The change from the day before needs that day's file first: bbs quotes
; fetch YYYYMMDD of the session before, then bbs quotes fetch
;[quotes]
;file = /var/lib/bbs/quotes.json.gz
; the symbols a caller sees before they choose their own
;default = SPY DIA QQQ AAPL MSFT
; a live TOPS feed (IEX's real-time feed, or its free delayed one; both need
; a connection to IEX): its UDP address (a multicast group, joined on the
; interface), and how far behind it is, for the callers
;listen = 233.215.21.4:10378
;interface = eth1
;delay = 15 minutes
; or Alpaca's market data (alpaca.markets), live: its free plan has IEX's
; trades and quotes for 30 symbols at a time on its stream (those callers
; looked at last, and default), any symbol by its snapshots.  The keys are
; an Alpaca account's (a paper-trading one will do): keep this file 0640.
; Alpaca's terms ask for 30 days' notice before its data is shown to
; others.  bbs quotes alpaca AAPL tries them
;alpaca_key = PK...
;alpaca_secret = ...
; iex (the free plan), sip (every exchange: a paid plan) or delayed_sip
;alpaca_feed = iex
; the most symbols on the stream at once (the free plan's limit)
;alpaca_symbols = 30

; Time.  The BBS's clock can follow time servers, and the BBS can be a
; time server itself: NTP, NTS (NTP made secure with TLS keys) and PTP.
; With no servers it tells of the system clock (kept by chrony, ntpd ...).
;[time]
; servers followed: KIND HOST, by commas.  ntp HOST[:PORT], nts HOST[:PORT]
; (its NTS-KE port, 4460 if none), ptp HOST (unicast; ports 319 and 320)
;servers = nts time.cloudflare.com, nts nts.netnod.se, ntp pool.ntp.org
; seconds between asking them (16 at least)
;poll = 64
; set the system clock (Linux; root, or CAP_SYS_TIME kept: with [general]
; user, systemd's AmbientCapabilities=CAP_SYS_TIME).  No: the BBS keeps
; the offset and serves corrected time, leaving the system clock alone
;set_clock = no
; with no servers: the stratum told (0: 3 while the kernel says the clock
; is synchronised, else unsynchronised), and stratum 1's reference (GPS, PPS)
;stratum = 0
;refid = GPS
; a PEM file NTS-KE servers' certificates are checked against ("": the system's)
;root_cas = /etc/bbs/nts-ca.pem
; TAI - UTC, in seconds, for PTP (37 since 2017)
;utc_offset = 37

; an NTP server (UDP).  Port 123 needs CAP_NET_BIND_SERVICE
;[ntp]
;address = :123
; requests a second an address may make (0: no limit), and at once
;rate = 2
;burst = 16

; an NTS-KE server (RFC 8915): TLS 1.3, its clients' keys and cookies for
; [ntp], which then answers NTS-secured requests too.  The certificate is
; read again when its file changes (a renewal); with no tls_cert and
; tls_key, the [acme] certificates
;[nts]
;address = :4460
;tls_cert = /etc/bbs/cert.pem
;tls_key = /etc/bbs/key.pem
; the NTP server clients are told to use ("": this one)
;ntp_host = time.example.org
;max_clients = 64
;max_per_ip = 8

; a PTP grandmaster (IEEE 1588, UDP ports 319 and 320, as root): two-step,
; end to end.  Multicast to 224.0.1.129 on interface, and unicast to the
; clients that ask (linuxptp's unicast_master_table, ptp4u's clients)
;[ptp]
; the address bound ("": all)
;address =
; multicast's interface, and hardware timestamps' ("": no multicast)
;interface = eth0
;multicast = yes
;unicast = yes
;domain = 0
;priority1 = 128
;priority2 = 128
; intervals, as powers of two seconds: multicast syncs (0: 1 s) and
; announcements (1: 2 s); the shortest a unicast client is granted (-4: 1/16 s)
;log_sync_interval = 0
;log_announce_interval = 1
;log_min_interval = -4
; unicast clients at once
;max_clients = 256
; software (the kernel's stamps) or hardware (the network card's: its
; clock kept on the system's, phc2sys -s CLOCK_REALTIME -c eth0 -O 0)
;timestamping = software

; Menus of the sysop's.  [menu main] takes the place of the built-in main
; menu (on 3270s too); others are reached from it.  Each item is
; KEY = ACTION Label: one character (not ; or #), then what it does:
;   areas mail who users profile info files doors chat page terminal
;   logoff back, or door:NAME menu:NAME screen:NAME area:NAME
; Labels, titles and prompts take @-codes (@USER@, @NEWMAIL@, @BBS@ ...)
; and tags ({yellow}, {bright}, {reset} ...: docs/wiki/Customization.md).
; screen = NAME shows that display file instead of the list of items
;[menu main]
;title = {cyan}{bright}@BBS@{reset}
;screen = mainmenu
;m = areas Message areas
;e = mail E-mail ({yellow}@NEWMAIL@{default} new)
;f = files File areas
;d = doors Doors
;c = chat Chat
;s = page Page the sysop
;w = who Who's online
;b = screen:bulletins {green}Bulletins{reset}
;x = menu:extras Extras
;g = logoff {red}Goodbye{reset}
;
;[menu extras]
;title = {cyan}Extras{reset}
;prompt = "{cyan}Extras{default}> "
;u = users User list
;p = profile Your profile
;i = info System info
;t = terminal Your terminal (3270)
;q = back Back

; The prompts and messages, with @-codes and tags (on 3270s, and in the
; welcome, tags are dropped):
;[strings]
;name_prompt = "{cyan}Name:{default} "
;new_name_prompt = "{cyan}Name{default} (or NEW): "
;password_prompt = "{cyan}Password:{default} "
;command_prompt = "{yellow}@USER@{default} @ {cyan}@BBS@{default} > "
;pause = "{blue}[Press a key]{reset}"
;logoff_confirm = "{red}Log off?{reset}"
;welcome = "Welcome, @USER@."
