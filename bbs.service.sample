[Unit]
Description=BBS for telnet, TN3270 and modem callers
After=network.target

[Service]
ExecStart=/usr/local/bin/bbs -config /etc/bbs/bbs.conf serve
# systemctl reload bbs: bbs.conf read again, what may change while callers
# are on put in force (the log says what waits for a restart)
ExecReload=/bin/kill -HUP $MAINPID
User=bbs
Group=bbs
# or: started as root, the BBS binds its ports and becomes [general] user
# itself (docs/wiki/Running.md): then no User= and Group= here, nor
# AmbientCapabilities, and RuntimeDirectory's directory is root's (put
# unix sockets where the user may write, or give them a socket_group)
# for [listen menu]'s socket_group = asterisk
SupplementaryGroups=asterisk
# for DOS doors in Docker (README, "Doors"): the docker group is as good as
# root, so think twice; rootless Docker or Podman is the safer way
#SupplementaryGroups=asterisk docker
RuntimeDirectory=bbs
RuntimeDirectoryMode=0750
StateDirectory=bbs
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
# port 23 (and finger's 79, gopher's 70) without root
#AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# the sysop's Configuration screen (on the BBS) writes bbs.conf: let it,
# with /etc/bbs and the file the bbs user's to write.  Without, it shows
# the file and says what would change, but cannot write it (bbs config, as
# root on the console, can)
#ReadWritePaths=/etc/bbs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
